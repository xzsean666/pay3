# ==============================================================================
# Pay3 机密与隐私环境变量模版 (.env.secrets.example)
# ==============================================================================
# 规范原则：
#   只有包含敏感密码、私钥、访问令牌的机密信息存放于本环境配置文件或 Secret Manager 中；
#   系统拓扑、业务模式、代币矩阵与区块链参数统一在 pay3.yaml 中配置。
#
# 使用方式:
#   cp .env.secrets.example .env
#   chmod 600 .env
#   pay3  # 系统会自动载入 pay3.yaml 并将此处定义的敏感机密安全注入
# ==============================================================================

# 1. 数据库持久化连接串（包含账号、密码等隐私连接凭证）
DATABASE_URL=postgres://pay3_user:your_secure_db_password@127.0.0.1:5432/pay3

# 2. 外部签名机 / KMS / Vault 访问令牌（生产环境敏感凭证）
# 如果在 pay3.yaml 中配置了 signer.mode: "external" / "kms" / "hsm"，在此提供 Bearer Token：
SIGNER_REMOTE_BEARER_TOKEN=prod_vault_signer_secret_token_12345

# ------------------------------------------------------------------------------
# 以下仅在本地开发/测试环境下可选配置，生产环境严格禁止：
# ------------------------------------------------------------------------------
# 3. 本地测试助记词 (仅 SIGNER_MODE=local 时使用，生产环境严禁配置)
# SIGNER_MNEMONIC="twelve word secret mnemonic phrase for local testing only"

# 4. 对称签名密钥 (仅本地开发使用，生产环境强制使用 RS256/EdDSA JWKS)
# JWT_SECRET=development_hs256_symmetric_secret_32bytes_min
