# Pay3 Production Environment Configuration Example
# This file provides a hardened template for production deployments.
# Production strictly requires external/KMS/HSM signer, at least two HTTPS RPC providers,
# asymmetric JWT key material (HTTPS JWKS URL or RS256/EdDSA PEM), and managed secret delivery.

APP_PROFILE=production
RUN_ROLE=all
PAY3_PORT=3000
APP_BIND=0.0.0.0:3000

# PostgreSQL Production Connection Pool (managed or HA replica)
DATABASE_URL=postgres://pay3_user:secret_prod_password@postgres.internal:5432/pay3_prod

# Asymmetric JWT Authentication (RS256 / EdDSA via Remote HTTPS JWKS or Public PEM)
# NOTE: HS256 and JWT_SECRET are strictly forbidden in production.
JWT_ISSUER=https://auth.company.internal
JWT_AUDIENCE=pay3-api
JWT_KEY_ID=prod-key-2026-v1
JWT_JWKS_URL=https://auth.company.internal/.well-known/jwks.json
API_RATE_LIMIT_PER_MINUTE=600

# EVM Chain & ERC20 Token (One Instance, One Token)
# Example: Polygon PoS Mainnet (Chain ID 137), USDT Token
CHAIN_ID=137
TOKEN_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
TOKEN_DECIMALS=6
TOKEN_SYMBOL=USDT

# Fund Destination Addresses
# TREASURY_ADDRESS: Exclusive target for automated collections
# PROBLEM_FUNDS_ADDRESS: Segregated destination for late/disputed payments (must differ from Treasury)
TREASURY_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
PROBLEM_FUNDS_ADDRESS=0x8ba1f109551bD432803012645Ac136ddd64DBA72

# Multi-RPC Load Balancing & Automatic Cooldown (Requires at least 2 distinct HTTPS endpoints)
RPC_HTTP_URLS=https://polygon-rpc.internal.node1:8545,https://polygon-rpc.internal.node2:8545

# Scanner Starting Height & Reorg Lookback Safety
# NOTE: START_BLOCK=0 is forbidden in production unless ALLOW_FULL_HISTORY_REPLAY=true
START_BLOCK=65000000
MIN_CONFIRMATIONS=64

# Hardened External Signer Configuration
# NOTE: Local mnemonic and fake signer are strictly forbidden in production.
SIGNER_MODE=external
SIGNER_KEY_REF=pay3-prod-master-key
SIGNER_REMOTE_ENDPOINT=https://signer.internal.vault:8443
SIGNER_REMOTE_BEARER_TOKEN=prod_token_from_vault_secrets_manager
SIGNER_REMOTE_REQUEST_TIMEOUT_SECS=15

# Legacy KVDB path placeholder for backwards compatibility
KVDB_PATH=/var/lib/pay3/kv
