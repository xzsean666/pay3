# Development/staging dry-run defaults for docker compose.
# Copy to .env and run with PAY3_ENV_FILE=.env for local changes.
# If using a non-.env file, pass it to both Compose interpolation and pay3:
# PAY3_ENV_FILE=staging.env docker compose --env-file staging.env up --build
#
# Do not use these values for production. Production still requires external
# signer, real RPC providers, strong JWT material, and managed secret delivery.

POSTGRES_USER=pay3
POSTGRES_PASSWORD=pay3_dev_password
POSTGRES_DB=pay3
POSTGRES_PORT=5432
PAY3_PORT=3000

# Pay3 connects through DATABASE_URL. This default points at the optional
# compose local-db profile. Override it for a managed/external PostgreSQL.
DATABASE_URL=postgres://pay3:pay3_dev_password@postgres:5432/pay3

APP_PROFILE=development
JWT_ISSUER=pay3
JWT_AUDIENCE=pay3-api
JWT_SECRET=dev-dry-run-jwt-secret-000000000000
JWT_KEY_ID=pay3-dev-key-1
API_RATE_LIMIT_PER_MINUTE=120

CHAIN_ID=31337
# Default dry-run expects an Anvil/local JSON-RPC on host port 8545 with chain id 31337.
# For token transfer/collect flows, deploy a mock ERC20 and replace TOKEN_ADDRESS.
TOKEN_ADDRESS=0x0000000000000000000000000000000000000001
TOKEN_DECIMALS=6
TOKEN_SYMBOL=USDT
TREASURY_ADDRESS=0x0000000000000000000000000000000000000002
RPC_HTTP_URLS=http://host.docker.internal:8545
START_BLOCK=1
MIN_CONFIRMATIONS=1

SIGNER_MODE=fake
SIGNER_KEY_REF=pay3-master

# Production/staging connected environments should set:
# APP_PROFILE=staging or production
# RPC_HTTP_URLS=https://rpc-provider-a.example,https://rpc-provider-b.example
# SIGNER_MODE=external
# SIGNER_REMOTE_ENDPOINT=https://signer.example.internal
# SIGNER_REMOTE_REQUEST_TIMEOUT_SECS=15
# JWT_JWKS_JSON from a secret/config manager, or JWT_PUBLIC_KEY_PEM + JWT_ALGORITHM=RS256/EdDSA + JWT_KEY_ID
# Do not set JWT_SECRET in production.
